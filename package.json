    "@x402/evm": "2.30.0",
    "@x402/fetch": "2.30.0",
    "genlayer-js": "1.1.8",
    "lucide-react": "0.548.0",
    "next": "16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
